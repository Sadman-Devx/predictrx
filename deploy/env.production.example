# PredictRx production environment. On the VM:  cp deploy/env.production.example .env  (repo root), then fill it in.
#
# RULES
#  * Never commit .env. Never paste keys into chat apps (a leaked key must be revoked and replaced).
#  * Each key appears ONCE. django-environ and Docker keep the FIRST value they read; a second line is silently ignored.
#  * Leave a key EMPTY rather than putting placeholder text in it: a non-empty fake key makes every call fail.
#  * Values below that docker-compose.prod.yml sets itself (DATABASE_URL, REDIS_URL, OLLAMA_BASE_URL, MCP_SERVER_URL,
#    DJANGO_SETTINGS_MODULE) are deliberately NOT listed here.

# ---------- Used by docker-compose.prod.yml itself ----------
# A long random password, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Your public DNS name WITHOUT https:// (e.g. predictrx-demo.<region>.cloudapp.azure.com). ":80" = plain HTTP test only.
SITE_ADDRESS=

# ---------- Django ----------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=<same host as SITE_ADDRESS>
CORS_ALLOWED_ORIGINS=https://<same host>
CSRF_TRUSTED_ORIGINS=https://<same host>
# Used inside emailed links (password reset, family invite). Must be the PUBLIC https URL, not localhost.
FRONTEND_URL=https://<same host>
# Caddy is exactly one proxy in front of Django.
NUM_PROXIES=1
AUTH_REFRESH_COOKIE_SECURE=true

# ---------- Email: Gmail SMTP (registration OTP, password reset, family invite) ----------
# Needs 2-Step Verification ON, then an App Password: https://myaccount.google.com/apppasswords
# (16 characters, WITHOUT spaces). Use port 587 with TLS.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PredictRx <your.address@gmail.com>
# The OTP lasts 60 seconds (OTP_TTL_SECONDS in apps/accounts/email_verification.py), at most 5 wrong guesses.
REQUIRE_EMAIL_VERIFICATION=true

# ---------- AI ----------
# Prescription scan through Gemini: GEMINI_* set AND SCAN_VISION_LOCAL=false (exactly one SCAN_VISION_LOCAL line).
# The image leaves this server: synthetic prescriptions only in the demo, and only after the patient's `analysis` consent.
GEMINI_API_KEY=
GEMINI_MODEL=
SCAN_VISION_LOCAL=false
# Ollama on the VM is used for embeddings. bge-m3 / 1024 must match the model that produced the stored vectors.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=48
EMBEDDING_TIMEOUT=180
# Only needed if SCAN_VISION_LOCAL=true or the optional local-LLM features are switched on.
LOCAL_LLM_MODEL=
ANTHROPIC_API_KEY=
CLOUD_LLM_MODEL=
RAG_CONTEXT_MODE=template

# ---------- Optional ----------
SENTRY_DSN=
OPENFDA_API_KEY=
