# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------- Database / cache ----------
DATABASE_URL=postgres://predictrx:predictrx@localhost:5433/predictrx
REDIS_URL=redis://localhost:6379/0

# ---------- AI ----------
# Cloud LLM (vision + reasoning). Never commit real keys.
ANTHROPIC_API_KEY=
CLOUD_LLM_MODEL=
# Local model through Ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=
# Embeddings (run on local Ollama). Dimension MUST match the embedding model you choose.
# Pull the model first:  docker compose exec ollama ollama pull <EMBEDDING_MODEL>
# Example: a multilingual 1024-dim model such as bge-m3 matches EMBEDDING_DIM=1024.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=120
# Contextual-RAG prefix per chunk: template (default, deterministic) | local (Ollama) | cloud
RAG_CONTEXT_MODE=template

# ---------- MCP ----------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001/sse

# ---------- Data sources ----------
OPENFDA_API_KEY=

# ---------- Privacy ----------
PRESCRIPTION_IMAGE_RETENTION_DAYS=7

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000/api

# ---------- Password reset email ----------
# Base URL of the frontend (used inside the reset link). Link format: <FRONTEND_URL>/reset-password?uid=..&token=..
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=3600
DEFAULT_FROM_EMAIL=PredictRx <no-reply@predictrx.local>
# Local dev prints emails to the console (config.settings.local). For real sending, set these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ---------- Social sign-in (leave a provider empty to keep it switched off) ----------
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# True: first social sign-in creates a doctor account. False: only existing accounts can use social sign-in.
SOCIAL_AUTO_CREATE=True