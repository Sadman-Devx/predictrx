# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------- Database / cache ----------
DATABASE_URL=postgres://predictrx:predictrx@localhost:5433/predictrx
REDIS_URL=redis://localhost:6379/0

# ---------- AI ----------
# Cloud LLM (vision + reasoning). Never commit real keys.
ANTHROPIC_API_KEY=
CLOUD_LLM_MODEL=
# Local model through Ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3.5:2b
LOCAL_LLM_TIMEOUT=300

# Cloud vision for prescription scans (Google AI Studio). Leave BOTH empty to stay local-only.
# Do not leave placeholder text here: a non-empty fake key makes every scan fail with "invalid key".
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional image-capable Gemini model; tried after primary rate-limit, availability, server, or network errors.
GEMINI_FALLBACK_MODEL=

# Embeddings (run on local Ollama). Dimension MUST match the embedding model you choose.
# Pull the model first:  docker compose exec ollama ollama pull <EMBEDDING_MODEL>
# Example: a multilingual 1024-dim model such as bge-m3 matches EMBEDDING_DIM=1024.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=48
EMBEDDING_TIMEOUT=180
# Contextual-RAG prefix per chunk: template (default, deterministic) | local (Ollama) | cloud
RAG_CONTEXT_MODE=template

# ---------- MCP ----------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001/sse

# ---------- Data sources ----------
OPENFDA_API_KEY=

# ---------- Privacy / prescription scan ----------
# Images are private and deleted at retain_until. Short by default; longer only with an active retain_images consent.
PRESCRIPTION_IMAGE_RETENTION_DAYS=7
PRESCRIPTION_IMAGE_RETAINED_DAYS=90
SCAN_MAX_UPLOAD_BYTES=8388608
SCAN_DEDUPE_WINDOW_SECONDS=600
SCAN_STUCK_MINUTES=10
# true = prescription images go ONLY to the local Ollama vision model (LOCAL_LLM_MODEL must be a vision model)
# false = Gemini is used when GEMINI_API_KEY + GEMINI_MODEL are set. Keep this line ONCE in the file: django-environ
# keeps the FIRST value it reads, so a second SCAN_VISION_LOCAL line is silently ignored.
SCAN_VISION_LOCAL=true

# ---------- Reverse proxy ----------
# Number of proxies in front of Django. Cloudflare Tunnel = 1 (config.settings.production defaults to 1). Local dev = 0.
# Needed so login/scan throttles and the audit log see the real client IP.
NUM_PROXIES=0

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000/api

# ---------- Email (password reset + family invite) ----------
# Base URL of the frontend (used inside password-reset links).
# On the live demo this MUST be the public URL, otherwise the emailed link points to localhost.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=3600
DEFAULT_FROM_EMAIL=PredictRx <no-reply@predictrx.local>

# Option 1 (default, no setup): leave EMAIL_BACKEND unset. Emails are printed in the runserver terminal; copy the code.
# IMPORTANT: keep EMAIL_BACKEND in this file only ONCE (the first line wins, a second one is silently ignored).

# Option 2: Mailpit, a fake inbox for local testing (docker compose up -d mailpit; inbox at http://localhost:8025)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False

# Option 3: real Gmail. Needs 2-Step Verification ON, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, write it WITHOUT spaces). Never commit this file.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.name@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=PredictRx <your.name@gmail.com>

# ---------- Email verification + session cookie ----------
# Doctor/pharmacist accounts must verify the 60-second email OTP before login.
REQUIRE_EMAIL_VERIFICATION=true
# Timeout for older signed verification links only; new OTPs always expire after 60 seconds.
EMAIL_VERIFICATION_TIMEOUT=172800
# The refresh token is kept in an httpOnly cookie, so a page reload keeps you signed in.
# Local dev (Vite proxy, one site): the defaults are right. Live demo over https:
#   AUTH_REFRESH_COOKIE_SECURE=true (config.settings.production already defaults to true)
#   If web app and API are on DIFFERENT sites also set AUTH_REFRESH_COOKIE_SAMESITE=None and add the web app URL to CORS_ALLOWED_ORIGINS.
# AUTH_REFRESH_COOKIE_SAMESITE=Lax
# AUTH_REFRESH_IN_BODY=false

# ---------- Social sign-in (leave a provider empty to keep it switched off) ----------
GOOGLE_CLIENT_ID=
# Google Identity Services ID-token flow uses the client ID; it does not use a Google client secret.
# Set the same ID in frontend/.env as VITE_GOOGLE_CLIENT_ID. Never expose a client secret through a VITE_ variable.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# True: first social sign-in creates a doctor account. False: only existing accounts can use social sign-in.
SOCIAL_AUTO_CREATE=True